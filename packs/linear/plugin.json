{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "linear",
  "version": "0.1.0",
  "description": "Develop Linear issues in CodeTwo and link verified pull-request delivery.",
  "author": { "name": "C2" },
  "license": "Apache-2.0",
  "repository": "https://github.com/IchenDEV/codeTwo",
  "keywords": ["linear", "issues", "development"],
  "extensions": {
    "dev.codetwo": {
      "standardVersion": "1.2.0",
      "commands": [{ "id": "linear.request", "title": "Linear", "description": "Read issues and synchronize development milestones." }],
      "runtime": { "protocol": "1.0.0", "command": "node", "args": ["plugin.js"] },
      "connectors": [{ "id": "issues", "provider": "linear", "command": "linear.request", "capabilities": ["connection", "issues"] }]
    }
  }
}
